# Copiez en .env. Ne commitez jamais .env.
# Dossier data/ du projet détecté par défaut : dépôt officiel complet OU contenu de son data/.
# CARTO_DATA=C:/Users/VotreNom/Documents/cards-database
CARTO_OLLAMA_URL=http://127.0.0.1:11434
CARTO_OLLAMA_MODEL=qwen2.5vl:7b
CARTO_OLLAMA_TIMEOUT=120
CARTO_OLLAMA_CONCURRENCY=1
# Facultatif. Vide = code aléatoire persistant dans storage/access-code.txt.
CARTO_INVITE_CODE=
# Pour un partage HTTPS : true. Pour HTTP local uniquement : false.
CARTO_SECURE_COOKIES=false
# Liste exacte d'origines autorisées, séparées par des virgules. Aucun joker.
# CARTO_ALLOWED_ORIGINS=https://cartosolver.votre-domaine.fr
CARTO_ALLOWED_ORIGINS=
